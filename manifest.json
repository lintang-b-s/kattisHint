{
  "manifest_version": 3,
  "name": "Kattis Hint Giver",
  "version": "1.0.0",
  "description": "Shows problem category and hints from methodstosolve on Kattis problem pages and listings.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.kattis.com/*",
    "https://cpbook.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.kattis.com/problems*"],
      "js": ["kattis.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
